# Copy this file to ".env" in the server/ folder and fill in your real key.
# The real .env is gitignored and never committed.
#
# Get a Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: the port the server listens on (defaults to 3000).
# Hosting platforms like Render set this automatically — leave it unset there.
# PORT=3000
